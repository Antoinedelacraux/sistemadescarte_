# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN — SISTEMA FUNDO (DONWEB FEROZO)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo con el nombre ".env" en la raíz del proyecto en Ferozo.
# 2. Configura tu APP_URL (con HTTPS) y los datos de tu base de datos MySQL.
# 3. Ejecuta: php artisan key:generate (si tienes SSH) o coloca una clave de 32 bytes.
# ==============================================================================

APP_NAME="TALSA Fundo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs del sistema: rotación diaria sin exponer datos sensibles
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ==============================================================================
# BASE DE DATOS MYSQL (DONWEB FEROZO)
# Crea la base de datos y usuario desde el panel Ferozo -> Bases de Datos MySQL
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nombre_de_tu_base_en_ferozo
DB_USERNAME=usuario_mysql_ferozo
DB_PASSWORD=contrasena_mysql_ferozo

# ==============================================================================
# SESIONES, CACHÉ Y COLAS
# Usan base de datos para máxima fiabilidad en hosting compartido Ferozo
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ==============================================================================
# ADMINISTRADOR INICIAL POR DEFECTO
# Al ejecutar "php artisan migrate --seed", se creará este administrador inicial
# ==============================================================================
ADMIN_NAME="Administrador General"
ADMIN_EMAIL=admin@talsa.com.pe
ADMIN_PASSWORD=CambiarEstaClaveSegura2026!
